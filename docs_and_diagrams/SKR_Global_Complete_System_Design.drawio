  <diagram id="skr-detailed-sys-design" name="SKR-Global Detailed System Design">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- HEADER BANNER -->
        <mxCell id="banner" value="SKR-Global Marine Logistics Import &amp; Export Management System (MLIEMS) — Complete Component-Level System Design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1620" height="55" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 1: REACT 18 FRONTEND (VERCEL) ==================== -->
        <mxCell id="col-fe" value="CLIENT TIER: React 18 + Vite SPA (Hosted on Vercel Edge)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;fontColor=#0F2942;fontStyle=1;fontSize=13;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="440" height="960" as="geometry"/>
        </mxCell>

        <!-- Entry & Routing -->
        <mxCell id="fe-entry" value="&lt;b&gt;main.jsx &amp; App.jsx (Router)&lt;/b&gt;&lt;br&gt;BrowserRouter • Public /login&lt;br&gt;ProtectedRoute(allowedRoles) Guards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="50" width="400" height="75" as="geometry"/>
        </mxCell>

        <!-- State & Shared Components -->
        <mxCell id="fe-context" value="&lt;b&gt;AuthContext.jsx&lt;/b&gt;&lt;br&gt;user, loading, login(),&lt;br&gt;register(), logout(), JWT Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="145" width="190" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="fe-navbar" value="&lt;b&gt;Navbar.jsx&lt;/b&gt;&lt;br&gt;SKR-Global Brand Header&lt;br&gt;Role-Filtered Console Tabs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="col-fe">
          <mxGeometry x="230" y="145" width="190" height="85" as="geometry"/>
        </mxCell>

        <!-- Pages -->
        <mxCell id="fe-login" value="&lt;b&gt;LoginPage.jsx&lt;/b&gt;&lt;br&gt;Sign-In &amp; Self-Registration Form&lt;br&gt;Role-Based Post-Login Redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="250" width="400" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="fe-dash" value="&lt;b&gt;DashboardPage.jsx (Shipments Console)&lt;/b&gt;&lt;br&gt;• Operator / Admin / Client Views&lt;br&gt;• Status Filter Dropdown &amp; Manifest Table&lt;br&gt;• Clickable Status Badge -&gt; Customs Reason Modal&lt;br&gt;• Port Weather Telemetry Banner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="345" width="400" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="fe-modal" value="&lt;b&gt;ShipmentFormModal.jsx&lt;/b&gt;&lt;br&gt;Book Import/Export BoL, UN/LOCODE Ports,&lt;br&gt;HS Code &amp; ISO 6346 Container Form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="col-fe">
          <mxGeometry x="45" y="490" width="350" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="fe-customs" value="&lt;b&gt;CustomsPage.jsx (Customs Console)&lt;/b&gt;&lt;br&gt;• Customs Officer &amp; Admin Only&lt;br&gt;• Clearance Status Filter (PENDING/REVIEW/APPROVED/REJECTED)&lt;br&gt;• Clickable BoL Link -&gt; BoL Inspection &amp; Review Modal&lt;br&gt;• Officer Reason Input &amp; Physical Scan Checkbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="585" width="400" height="130" as="geometry"/>
        </mxCell>

        <!-- API Client & Hosting Config -->
        <mxCell id="fe-axios" value="&lt;b&gt;api/client.js (Axios Instance)&lt;/b&gt;&lt;br&gt;BaseURL: VITE_API_URL&lt;br&gt;Request Interceptor: Injects Bearer &amp;lt;JWT&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="740" width="400" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="fe-config" value="&lt;b&gt;styles.css &amp; vercel.json&lt;/b&gt;&lt;br&gt;WCAG 2.1 AA Responsive Maritime Theme • SPA Rewrite Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontColor=#0F2942;fontSize=10.5;" vertex="1" parent="col-fe">
          <mxGeometry x="20" y="845" width="400" height="75" as="geometry"/>
        </mxCell>

        <!-- Internal FE Connectors -->
        <mxCell id="fe-c1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0284C7;" edge="1" parent="col-fe" source="fe-dash" target="fe-modal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== COLUMN 2: EXPRESS.JS REST API (RENDER) ==================== -->
        <mxCell id="col-be" value="APPLICATION TIER: Node.js + Express REST API (Hosted on Render)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F2942;fontColor=#0F2942;fontStyle=1;fontSize=13;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="530" y="95" width="660" height="960" as="geometry"/>
        </mxCell>

        <!-- Server Entry & Global Security -->
        <mxCell id="be-server" value="&lt;b&gt;server.js &amp; config/db.js&lt;/b&gt;&lt;br&gt;DNS Override (8.8.8.8 / 1.1.1.1) • dotenv • Mongoose connectDB()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#334155;fontSize=11;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="50" width="620" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="be-app" value="&lt;b&gt;app.js — Global Security &amp; Parsing Pipeline&lt;/b&gt;&lt;br&gt;1. helmet() HTTP Security Headers   |   2. cors() Origin Whitelist (CLIENT_ORIGIN)   |   3. express-rate-limit (150 req / 15m)&lt;br&gt;4. express.json({ limit: '10kb' })   |   5. express-mongo-sanitize (NoSQLi Strip)   |   6. morgan() Logger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="130" width="620" height="85" as="geometry"/>
        </mxCell>

        <!-- Auth Middleware -->
        <mxCell id="be-auth-mw" value="&lt;b&gt;middleware/auth.middleware.js&lt;/b&gt;&lt;br&gt;• protect(): Verifies JWT Signature &amp; Active User&lt;br&gt;• authorize(...roles): Enforces RBAC (admin, operator, customs, client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="235" width="620" height="75" as="geometry"/>
        </mxCell>

        <!-- Routes Column -->
        <mxCell id="be-r-auth" value="&lt;b&gt;routes/auth.routes.js&lt;/b&gt;&lt;br&gt;POST /api/v1/auth/register&lt;br&gt;POST /api/v1/auth/login&lt;br&gt;GET /api/v1/auth/me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2942;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="335" width="190" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="be-r-ship" value="&lt;b&gt;routes/shipment.routes.js&lt;/b&gt;&lt;br&gt;GET /api/v1/shipments&lt;br&gt;POST /api/v1/shipments&lt;br&gt;GET/PUT/DELETE /:id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2942;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="460" width="190" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="be-r-cust" value="&lt;b&gt;routes/customs.routes.js&lt;/b&gt;&lt;br&gt;GET /api/v1/customs&lt;br&gt;POST /api/v1/customs&lt;br&gt;PATCH /:id/review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2942;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="585" width="190" height="105" as="geometry"/>
        </mxCell>

        <!-- Controllers Column -->
        <mxCell id="be-c-auth" value="&lt;b&gt;controllers/auth.controller.js&lt;/b&gt;&lt;br&gt;• express-validator Input Check&lt;br&gt;• Prevents Admin Self-Signup&lt;br&gt;• Signs JWT (8h Expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="235" y="335" width="205" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="be-c-ship" value="&lt;b&gt;controllers/shipment.controller.js&lt;/b&gt;&lt;br&gt;• Client Owner Scoping (client: user._id)&lt;br&gt;• Enriches Shipments with Customs Notes&lt;br&gt;• Calls Port Weather Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="235" y="460" width="205" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="be-c-cust" value="&lt;b&gt;controllers/customs.controller.js&lt;/b&gt;&lt;br&gt;• Populates Full BoL Shipment Data&lt;br&gt;• Saves Officer Decision &amp; Reason&lt;br&gt;• Syncs Parent Shipment Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="235" y="585" width="205" height="105" as="geometry"/>
        </mxCell>

        <!-- Models & Services Column -->
        <mxCell id="be-m-user" value="&lt;b&gt;models/User.model.js&lt;/b&gt;&lt;br&gt;bcrypt Pre-Save Hook (12 Rounds)&lt;br&gt;select: false on password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="460" y="335" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="be-m-ship" value="&lt;b&gt;models/Shipment.model.js&lt;/b&gt;&lt;br&gt;Embedded ISO 6346 Containers&lt;br&gt;Index: (status, portOfDischarge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="460" y="430" width="180" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="be-m-cust" value="&lt;b&gt;models/CustomsDeclaration.js&lt;/b&gt;&lt;br&gt;HS Tariff, Duty, VAT, Status,&lt;br&gt;officerNotes, reviewedBy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="460" y="530" width="180" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="be-svc-weather" value="&lt;b&gt;services/portWeather.service.js&lt;/b&gt;&lt;br&gt;UN/LOCODE -&gt; Lat/Lon Lookup&lt;br&gt;Knots Conversion &amp; Fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="460" y="630" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Error Middleware & Seed -->
        <mxCell id="be-err" value="&lt;b&gt;middleware/error.middleware.js&lt;/b&gt;&lt;br&gt;Centralised HTTP Status Mapper: CastError (400), Duplicate Key 11000 (409), ValidationError (400), Server Error (500)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="735" width="620" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="be-seed" value="&lt;b&gt;seed.js &amp; /api/v1/health&lt;/b&gt;&lt;br&gt;Populates 4 SKR-Global RBAC Users, 50 Shipments &amp; 50 Customs Declarations • Uptime Health Check Endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontSize=10.5;" vertex="1" parent="col-be">
          <mxGeometry x="20" y="835" width="620" height="85" as="geometry"/>
        </mxCell>

