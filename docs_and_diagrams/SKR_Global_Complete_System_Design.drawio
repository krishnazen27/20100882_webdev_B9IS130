        </mxCell>

        <!-- ==================== COLUMN 3: DATA & EXTERNAL SERVICES ==================== -->
        <mxCell id="col-data" value="DATA &amp; EXTERNAL SERVICES TIER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#0F2942;fontStyle=1;fontSize=13;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="1250" y="95" width="400" height="960" as="geometry"/>
        </mxCell>

        <!-- MongoDB Atlas -->
        <mxCell id="db-cluster" value="&lt;b&gt;MongoDB Atlas M0 Cluster&lt;/b&gt;&lt;br&gt;(AWS eu-west-1 Ireland • TLS Encrypted)&lt;br&gt;Database: &lt;i&gt;marine_logistics&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" vertex="1" parent="col-data">
          <mxGeometry x="45" y="55" width="310" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="col-users" value="&lt;b&gt;Collection: users&lt;/b&gt;&lt;br&gt;_id, fullName, email (unique), password (hash),&lt;br&gt;role (admin|operator|customs|client), companyName" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=10.5;" vertex="1" parent="col-data">
          <mxGeometry x="30" y="210" width="340" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="col-shipments" value="&lt;b&gt;Collection: shipments&lt;/b&gt;&lt;br&gt;_id, billOfLading (unique), shipmentType, vesselName,&lt;br&gt;portOfLoading, portOfDischarge, etd, eta, hsCode,&lt;br&gt;containers: [{ containerNumber, sizeType, sealNumber }],&lt;br&gt;status, client (ObjectId), createdBy (ObjectId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=10.5;" vertex="1" parent="col-data">
          <mxGeometry x="30" y="315" width="340" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="col-customs" value="&lt;b&gt;Collection: customsdeclarations&lt;/b&gt;&lt;br&gt;_id, declarationNumber (unique), shipment (Ref),&lt;br&gt;tariffClassification, dutyAssessedUSD, vatAssessedUSD,&lt;br&gt;clearanceStatus, officerNotes, reviewedBy (Ref)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=10.5;" vertex="1" parent="col-data">
          <mxGeometry x="30" y="455" width="340" height="105" as="geometry"/>
        </mxCell>

        <!-- External OpenWeatherMap -->
        <mxCell id="ext-owm" value="&lt;b&gt;OpenWeatherMap REST API&lt;/b&gt;&lt;br&gt;GET api.openweathermap.org/data/2.5/weather&lt;br&gt;Returns Wind Speed, Temp &amp; Berthing Risk" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F2942;fontSize=11;" vertex="1" parent="col-data">
          <mxGeometry x="30" y="595" width="340" height="145" as="geometry"/>
        </mxCell>

        <!-- GitHub CI/CD -->
        <mxCell id="ext-github" value="&lt;b&gt;GitHub Repository &amp; CI/CD Pipelines&lt;/b&gt;&lt;br&gt;• Push to main triggers Vercel Frontend Build&lt;br&gt;• Push to main triggers Render Backend Deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2942;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="col-data">
          <mxGeometry x="30" y="775" width="340" height="105" as="geometry"/>
        </mxCell>

