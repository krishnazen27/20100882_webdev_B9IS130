        </mxCell>

        <mxCell id="db-atlas" value="&lt;b&gt;MongoDB Atlas (AWS Ireland)&lt;/b&gt;&lt;br&gt;M0 Cloud Cluster (TLS)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Users&lt;/b&gt; Collection&lt;br&gt;• &lt;b&gt;Shipments&lt;/b&gt; (Embedded Containers)&lt;br&gt;• &lt;b&gt;CustomsDeclarations&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=11.5;" vertex="1" parent="tier4-box">
