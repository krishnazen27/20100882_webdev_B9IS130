        <mxCell id="fe-cust" value="&lt;b&gt;Customs Console (CustomsPage)&lt;/b&gt;&lt;br&gt;Clearance Status Filter,&lt;br&gt;BoL Inspection &amp; Review Modal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#1E293B;fontSize=11.5;" vertex="1" parent="tier2-box">
          <mxGeometry x="25" y="330" width="250" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="fe-axios" value="&lt;b&gt;Axios HTTP Client &amp; Interceptor&lt;/b&gt;&lt;br&gt;Attaches Authorization: Bearer &amp;lt;JWT&amp;gt;&lt;br&gt;vercel.json SPA Rewrite Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F2942;fontSize=11.5;" vertex="1" parent="tier2-box">
          <mxGeometry x="25" y="480" width="250" height="105" as="geometry"/>
