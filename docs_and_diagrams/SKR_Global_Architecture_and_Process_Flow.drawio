        </mxCell>

        <mxCell id="be-sec" value="&lt;b&gt;OWASP Security &amp; Middleware Pipeline&lt;/b&gt;&lt;br&gt;Helmet Headers • CORS Whitelist • Rate Limiter&lt;br&gt;express-mongo-sanitize • JWT protect() &amp; authorize()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;" vertex="1" parent="tier3-box">
