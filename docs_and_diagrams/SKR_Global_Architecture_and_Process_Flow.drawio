        <mxCell id="fe-ship" value="&lt;b&gt;Shipments Console (DashboardPage)&lt;/b&gt;&lt;br&gt;Booking Modal, Status Filter,&lt;br&gt;Customs Message Popup, Port Weather" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#1E293B;fontSize=11.5;" vertex="1" parent="tier2-box">
