        </mxCell>

        <mxCell id="be-routes" value="&lt;b&gt;Versioned REST Routers (/api/v1)&lt;/b&gt;&lt;br&gt;/auth  •  /shipments  •  /customs  •  /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2942;fontColor=#1E293B;fontSize=11.5;" vertex="1" parent="tier3-box">
          <mxGeometry x="25" y="185" width="280" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="be-ctrl" value="&lt;b&gt;Controllers &amp; Business Logic&lt;/b&gt;&lt;br&gt;auth.controller • shipment.controller (Owner Scoping)&lt;br&gt;customs.controller (Atomic Shipment Status Sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2942;fontColor=#1E293B;fontSize=11;" vertex="1" parent="tier3-box">
          <mxGeometry x="25" y="300" width="280" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="be-svc" value="&lt;b&gt;External Service &amp; Error Layer&lt;/b&gt;&lt;br&gt;portWeather.service.js (Knots &amp; Berthing Risk)&lt;br&gt;Centralised error.middleware.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F2942;fontSize=11;" vertex="1" parent="tier3-box">
          <mxGeometry x="25" y="430" width="280" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="be-odm" value="&lt;b&gt;Mongoose ODM &amp; Schema Validation&lt;/b&gt;&lt;br&gt;bcrypt (12 rounds) • ISO 6346 Regex • UN/LOCODE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2942;fontColor=#1E293B;fontSize=11;" vertex="1" parent="tier3-box">
          <mxGeometry x="25" y="555" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- Tier 4: Data & External Services -->
